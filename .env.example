# Optional public origin, once the hosting/domain is selected.
SITE_URL=

# Set BOTH values to activate live Google Sheets. Keep API key server-only.
# Current prepared sheet: 1_c3LU0bGnlkpPgSp6WXUTSe0mId_WjArSk4Keg5pK0k
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEET_RANGE="'Каталог'!A1:I1001"

# Admin: a Google Web application client ID, not the public catalog API key.
ADMIN_GOOGLE_CLIENT_ID=
# Comma-separated Google email addresses allowed to administer this shop.
ADMIN_EMAILS=
# Generate a random value of at least 32 characters; never use this example.
ADMIN_SESSION_SECRET=

# Google service account shared as Editor on the catalog spreadsheet only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Multiline PKCS8 PEM key, or a quoted value with literal \n escapes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Cloudinary: signed preset with image format and size restrictions.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Docker/Caddy deployment only: bare domain, without https:// or a path.
SITE_HOST=
